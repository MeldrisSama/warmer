<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument><files><clear/><add value="index.php"/></files></defaultDocument>
    <directoryBrowse enabled="false"/>
    <staticContent><remove fileExtension=".webmanifest"/><mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json"/></staticContent>
    <security>
      <requestFiltering>
        <hiddenSegments><add segment="uploads"/><add segment="private"/><add segment="vendor"/></hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
